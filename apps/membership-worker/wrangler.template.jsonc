// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "cookpool-membership-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  // Smart Placement (SM-3): Cloudflare may run this Worker next to the
  // Asia–Pacific database instead of next to the caller, so the D1 queries of
  // one request stay close to it. Declared once, at the top level: wrangler
  // inherits `placement` into every environment, and the rendered stage and
  // prod configs carry it (tests/config-worker asserts so). It moves fetch
  // handlers only, which is how every call reaches this Worker (requests and
  // service-binding fetches); nothing else changes.
  "placement": { "mode": "smart" },
  "vars": {
    "ENVIRONMENT": "local",
    "DEBUG_DELIVERY": "true",
    // M0 / Solo profile — OFF: Cookpool is many small groups, one organization
    // per group (CP-2). Must match api-edge/identity-worker.
    "SOLO_MODE": "false",
    // Open groups (CP-2): every group a person creates stands alone (no
    // billing parent, no multi-org plan gate), up to 50 groups per person.
    "OPEN_GROUPS": "true"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "false",
        "OPEN_GROUPS": "true"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "false",
        "OPEN_GROUPS": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-stage-apac",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-stage"
        },
        {
          "binding": "BILLING_WORKER",
          "service": "cookpool-billing-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-stage"
        },
        // Leaving a group asks the kitchen for the caller's balance (CP-19).
        {
          "binding": "KITCHEN_WORKER",
          "service": "cookpool-kitchen-worker-stage"
        },
        // The signed-out join preview names the group's first owner (SI-4):
        // identity-worker's internal people lookup.
        {
          "binding": "IDENTITY_WORKER",
          "service": "cookpool-identity-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "DEBUG_DELIVERY": "false",
        "SOLO_MODE": "false",
        "OPEN_GROUPS": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-prod-apac",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-prod"
        },
        {
          "binding": "BILLING_WORKER",
          "service": "cookpool-billing-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-prod"
        },
        // Leaving a group asks the kitchen for the caller's balance (CP-19).
        {
          "binding": "KITCHEN_WORKER",
          "service": "cookpool-kitchen-worker-prod"
        },
        // The signed-out join preview names the group's first owner (SI-4):
        // identity-worker's internal people lookup.
        {
          "binding": "IDENTITY_WORKER",
          "service": "cookpool-identity-worker-prod"
        }
      ]
    }
  }
}
