# PERF10 — immutable caching for content-hashed build assets.
#
# Next.js fingerprints every file under /_next/static/ (the hash is in the
# filename), so a content change always produces a new URL and stale cached
# copies become unreachable. They are therefore safe to cache for a year with
# no revalidation. The Cloudflare default for these assets is
# `public, max-age=0, must-revalidate`, which forces the browser to send a
# conditional request (304) for every chunk on every repeat visit — slow.
#
# Files in this `public/` directory are copied to the asset root
# (`.open-next/assets/`) by the @opennextjs/cloudflare adapter, where Pages
# honours `_headers`. The pages served as files (Cookpool SM-2,
# scripts/pages-as-files.mjs) and their `/_rsc/*` payloads keep the default:
# their names do not change between deploys, so they revalidate (ETag) on
# every visit. The Worker's pages stay `no-store`.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cookpool PW-4: the service worker. The browser checks it for a new build on
# every launch (scripts/service-worker.mjs writes it per build); it must never
# be served from an HTTP cache, or an update would wait for the cache to age.
/sw.js
  Cache-Control: no-cache

# cookpool-spliteco SE3: WebAuthn related origins. Cookpool's passkeys (RP ID
# stage.cookpool.store / cookpool.store) also sign in on the Spliteco app's
# host; the browser reads this list from the RP ID's own origin, as JSON.
# identity-worker's PASSKEY_ORIGINS decides which of them it accepts per
# environment.
/.well-known/webauthn
  Content-Type: application/json
  Cache-Control: public, max-age=3600
