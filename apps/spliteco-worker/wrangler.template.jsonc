// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
//
// Spliteco (cookpool-spliteco SE1): the money API under /v1/spliteco/…, reached
// only through api-edge's SPLITECO_WORKER binding (workers_dev off on stage and
// prod). It reads and writes the same D1 ledger kitchen-worker does.
{
  "name": "cookpool-spliteco-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  // Smart Placement, as kitchen-worker: run next to the Asia–Pacific database.
  "placement": { "mode": "smart" },
  "vars": {
    "ENVIRONMENT": "local",
    "APP_URL": "http://localhost:3002"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "APP_URL": "http://localhost:3002"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        // The links in reminders and "paid you" (SE2): the app's workers.dev host until a domain is attached.
        "APP_URL": "https://cookpool-spliteco-web-stage.cookpool.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-stage-apac",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "cookpool-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-stage"
        },
        {
          "binding": "IDENTITY_WORKER",
          "service": "cookpool-identity-worker-stage"
        },
        // Reminders and "paid you" (SE2): POST /v1/notifications, email plus push.
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        // The links in reminders and "paid you" (SE2): the app's workers.dev host until a domain is attached.
        "APP_URL": "https://cookpool-spliteco-web-prod.cookpool.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-prod-apac",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "cookpool-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-prod"
        },
        {
          "binding": "IDENTITY_WORKER",
          "service": "cookpool-identity-worker-prod"
        },
        // Reminders and "paid you" (SE2): POST /v1/notifications, email plus push.
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-prod"
        }
      ]
    }
  }
}
