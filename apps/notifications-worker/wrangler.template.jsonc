// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "cookpool-notifications-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  // Smart Placement (SM-3): Cloudflare may run this Worker next to the
  // Asia–Pacific database instead of next to the caller, so the D1 queries of
  // one request stay close to it. Declared once, at the top level: wrangler
  // inherits `placement` into every environment, and the rendered stage and
  // prod configs carry it (tests/config-worker asserts so). It moves fetch
  // handlers only, which is how every call reaches this Worker (requests and
  // service-binding fetches); nothing else changes.
  "placement": { "mode": "smart" },
  "vars": {
    "ENVIRONMENT": "local",
    "NOTIFICATIONS_PROVIDER": "local-debug",
    "DEBUG_DELIVERY": "true"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "NOTIFICATIONS_PROVIDER": "local-debug",
        "DEBUG_DELIVERY": "true"
      }
    },
    "stage": {
      "workers_dev": false,
      // cloudflare-email sends through the Email Service `send_email` binding.
      // One-time account prerequisites before real delivery works: Workers
      // Paid plan, sending domain verified in Email Service (DKIM/SPF), and
      // EMAIL_FROM_ADDRESS on that verified domain. Until then the worker
      // still deploys; failed sends surface as notification.failed events.
      //
      // Web Push (Cookpool PW-5): VAPID_PUBLIC_KEY is this environment's VAPID
      // public key (base64url, uncompressed P-256), a plain var; its private
      // key is the VAPID_PRIVATE_KEY secret, pushed at deploy from orun
      // secrets (component.yaml), never here. Each environment has its own
      // pair. With either missing, push is off and email is unaffected.
      // TODO(PW-5 keys): run `node apps/notifications-worker/scripts/vapid-keys.mjs`,
      // put its public key here, and store its private key with
      // `orun secrets set VAPID_PRIVATE_KEY --workspace ws_QX130J0D --env stage`.
      "vars": {
        "ENVIRONMENT": "stage",
        "NOTIFICATIONS_PROVIDER": "cloudflare-email",
        "DEBUG_DELIVERY": "true",
        "EMAIL_FROM_ADDRESS": "no-reply@mail.cookpool.store",
        "EMAIL_FROM_NAME": "cookpool",
        "VAPID_PUBLIC_KEY": ""
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-stage-apac",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "EVENTS_WORKER",
          "service": "cookpool-events-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      // Web Push (PW-5), as stage, with prod's own pair.
      // TODO(PW-5 keys): run `node apps/notifications-worker/scripts/vapid-keys.mjs`,
      // put its public key here, and store its private key with
      // `orun secrets set VAPID_PRIVATE_KEY --workspace ws_QX130J0D --env prod`.
      "vars": {
        "ENVIRONMENT": "prod",
        "NOTIFICATIONS_PROVIDER": "cloudflare-email",
        "DEBUG_DELIVERY": "false",
        "EMAIL_FROM_ADDRESS": "no-reply@mail.cookpool.store",
        "EMAIL_FROM_NAME": "cookpool",
        "VAPID_PUBLIC_KEY": ""
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-prod-apac",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "EVENTS_WORKER",
          "service": "cookpool-events-worker-prod"
        }
      ]
    }
  }
}
