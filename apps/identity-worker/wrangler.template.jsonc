// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "cookpool-identity-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  // Smart Placement (SM-3): Cloudflare may run this Worker next to the
  // Asia–Pacific database instead of next to the caller, so the D1 queries of
  // one request stay close to it. Declared once, at the top level: wrangler
  // inherits `placement` into every environment, and the rendered stage and
  // prod configs carry it (tests/config-worker asserts so). It moves fetch
  // handlers only, which is how every call reaches this Worker (requests and
  // service-binding fetches); nothing else changes.
  "placement": { "mode": "smart" },
  // OAuth (B1) configuration:
  //   - Non-secret vars are declared per-env below. Replace the empty
  //     {GITHUB,GOOGLE}_OAUTH_CLIENT_ID placeholders with the client id of the
  //     OAuth app registered for that provider + environment.
  //   - Secrets are NEVER stored here. Set them with:
  //       wrangler secret put GITHUB_OAUTH_CLIENT_SECRET --env <env>
  //       wrangler secret put GOOGLE_OAUTH_CLIENT_SECRET --env <env>
  //       wrangler secret put OAUTH_STATE_SECRET         --env <env>
  //   - Each OAuth app's authorized redirect/callback URL must be:
  //       {OAUTH_REDIRECT_BASE_URL}/v1/auth/oauth/{github|google}/callback
  // Passkeys (Cookpool PK-2): PASSKEY_RP_ID is the WebAuthn relying party —
  // localhost (local, dev), stage.cookpool.store, cookpool.store — and
  // PASSKEY_ORIGINS the exact origins a ceremony may come from, comma-separated.
  // Prod lists only https://cookpool.store (and its Spliteco host, SE-4), so a stage page can never sign in
  // to prod. An empty PASSKEY_RP_ID turns every passkey route off (404
  // passkeys_off); the workers.dev console hosts offer no passkeys.
  // The Spliteco app (cookpool-spliteco SE-4) signs in against this worker on
  // its own host, cookpool-spliteco-web-<env>.cookpool.workers.dev: that
  // origin is in OAUTH_ALLOWED_CONSOLE_ORIGINS (Google and GitHub return
  // there) and PASSKEY_ORIGINS (the same passkeys, under the same RP ID —
  // the console lists the app at /.well-known/webauthn, WebAuthn's related
  // origins), and HANDOFF_ORIGINS is where a one-time handoff code from
  // Cookpool's "More in Spliteco" may be made for and exchanged from. Tripeco
  // (tripeco TR-5) is a HANDOFF_ORIGINS target too: it signs in through
  // Spliteco's /handoff/out, on cookpool-tripeco-web-<env>.cookpool.workers.dev.
  // DEBUG_DELIVERY_DOMAINS (Cookpool SI-2): the email domains whose sign-in
  // codes login/start returns on screen instead of emailing; `*` is every
  // domain. Local, dev and stage `*` (SI-9: stage sends no email yet, so the
  // owner chose to show every code there), prod none.
  "vars": {
    "ENVIRONMENT": "local",
    "DEBUG_DELIVERY_DOMAINS": "*",
    "GITHUB_OAUTH_CLIENT_ID": "",
    "GOOGLE_OAUTH_CLIENT_ID": "",
    "OAUTH_REDIRECT_BASE_URL": "http://localhost:8787",
    "OAUTH_ALLOWED_CONSOLE_ORIGINS": "http://localhost:3000,http://localhost:3002",
    "SOLO_MODE": "false",
    "PASSKEY_RP_ID": "localhost",
    "PASSKEY_RP_NAME": "Cookpool",
    "PASSKEY_ORIGINS": "http://localhost:3000,http://localhost:3002",
    "HANDOFF_ORIGINS": "http://localhost:3002"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "DEBUG_DELIVERY_DOMAINS": "*",
        "GITHUB_OAUTH_CLIENT_ID": "",
        "GOOGLE_OAUTH_CLIENT_ID": "",
        "OAUTH_REDIRECT_BASE_URL": "",
        "OAUTH_ALLOWED_CONSOLE_ORIGINS": "https://cookpool-web-console-next-dev.cookpool.workers.dev,https://cookpool-spliteco-web-dev.cookpool.workers.dev",
        "SOLO_MODE": "false",
        "PASSKEY_RP_ID": "localhost",
        "PASSKEY_RP_NAME": "Cookpool",
        "PASSKEY_ORIGINS": "http://localhost:3000,http://localhost:3002",
        "HANDOFF_ORIGINS": "https://cookpool-spliteco-web-dev.cookpool.workers.dev,https://cookpool-tripeco-web-dev.cookpool.workers.dev"
      }
    },
    "stage": {
      // Private (CP-9): reached only through service bindings, like
      // membership-worker. It serves /v1/internal/identity/users/lookup,
      // which must never answer on a public URL; api-edge is the way in.
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "DEBUG_DELIVERY_DOMAINS": "*",
        "GITHUB_OAUTH_CLIENT_ID": "Ov23liKBsjAqJJsmBavV",
        "GOOGLE_OAUTH_CLIENT_ID": "437655333636-omhv3akn7eul8bc1kpbrijrgfr2v245i.apps.googleusercontent.com",
        "OAUTH_REDIRECT_BASE_URL": "https://cookpool-api-edge-stage.cookpool.workers.dev",
        "OAUTH_ALLOWED_CONSOLE_ORIGINS": "https://stage.cookpool.store,https://cookpool-web-console-next-stage.cookpool.workers.dev,https://cookpool-spliteco-web-stage.cookpool.workers.dev",
        "SOLO_MODE": "false",
        "PASSKEY_RP_ID": "stage.cookpool.store",
        "PASSKEY_RP_NAME": "Cookpool",
        "PASSKEY_ORIGINS": "https://stage.cookpool.store,https://cookpool-spliteco-web-stage.cookpool.workers.dev",
        "HANDOFF_ORIGINS": "https://cookpool-spliteco-web-stage.cookpool.workers.dev,https://cookpool-tripeco-web-stage.cookpool.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-stage-apac",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "cookpool-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      // Private (CP-9): reached only through service bindings, like
      // membership-worker. It serves /v1/internal/identity/users/lookup,
      // which must never answer on a public URL; api-edge is the way in.
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "DEBUG_DELIVERY_DOMAINS": "",
        "GITHUB_OAUTH_CLIENT_ID": "Ov23lilp2aoyeBDVU8Vc",
        "GOOGLE_OAUTH_CLIENT_ID": "437655333636-omhv3akn7eul8bc1kpbrijrgfr2v245i.apps.googleusercontent.com",
        "OAUTH_REDIRECT_BASE_URL": "https://cookpool-api-edge-prod.cookpool.workers.dev",
        "OAUTH_ALLOWED_CONSOLE_ORIGINS": "https://cookpool.store,https://cookpool-web-console-next-prod.cookpool.workers.dev,https://cookpool-spliteco-web-prod.cookpool.workers.dev",
        "SOLO_MODE": "false",
        "PASSKEY_RP_ID": "cookpool.store",
        "PASSKEY_RP_NAME": "Cookpool",
        "PASSKEY_ORIGINS": "https://cookpool.store,https://cookpool-spliteco-web-prod.cookpool.workers.dev",
        "HANDOFF_ORIGINS": "https://cookpool-spliteco-web-prod.cookpool.workers.dev,https://cookpool-tripeco-web-prod.cookpool.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-prod-apac",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "cookpool-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-prod"
        }
      ]
    }
  }
}
