// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "cookpool-kitchen-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  // Smart Placement (SM-3): Cloudflare may run this Worker next to the
  // Asia–Pacific database instead of next to the caller, so the D1 queries of
  // one request stay close to it. Declared once, at the top level: wrangler
  // inherits `placement` into every environment, and the rendered stage and
  // prod configs carry it (tests/config-worker asserts so). It moves fetch
  // handlers only, which is how every call reaches this Worker (requests and
  // service-binding fetches); the cron sweep runs where Cloudflare
  // schedules it, as before.
  "placement": { "mode": "smart" },
  // Cookpool AI (AI-2): ANTHROPIC_API_KEY is a runtime secret, pushed at
  // deploy from orun secrets (component.yaml: optionalSecretEnv and
  // runtimeSecrets), one per environment — never a var here. Without it every
  // AI route answers 503 ai_unavailable (tests/config-worker asserts so).
  // AI cost guardrails (AI-13), plain vars in every environment: AI_ESCALATE
  // "on" retries a failed Haiku read once on Sonnet ("off": no retry), and
  // AI_MONTHLY_BUDGET_USD turns AI off for everyone once the UTC month's
  // estimated cost reaches it.
  "vars": {
    "ENVIRONMENT": "local",
    // Where the app is: the links in Cookpool's emails (CP-18) start here.
    "APP_URL": "http://localhost:3000",
    "AI_ESCALATE": "off",
    "AI_MONTHLY_BUDGET_USD": "5"
  },
  // Two jobs, picked by scheduled() from controller.cron: the daily use-soon
  // sweep (CP-18) at 02:30 UTC, 08:00 IST, and the timer sweep (GC-3) every
  // minute — a timer reaches a locked phone within a minute of its end.
  // Declared once, at the top level, so every environment inherits both — the
  // rendered stage and prod configs carry them (tests/config-worker asserts so).
  // A scheduled() without a trigger never runs, and fails silently (risks CP-N).
  "triggers": {
    "crons": ["30 2 * * *", "* * * * *"]
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "APP_URL": "http://localhost:3000",
        "AI_ESCALATE": "off",
        "AI_MONTHLY_BUDGET_USD": "5"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "APP_URL": "https://stage.cookpool.store",
        "AI_ESCALATE": "off",
        "AI_MONTHLY_BUDGET_USD": "5"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-stage-apac",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "cookpool-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-stage"
        },
        {
          "binding": "IDENTITY_WORKER",
          "service": "cookpool-identity-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "APP_URL": "https://cookpool.store",
        "AI_ESCALATE": "off",
        "AI_MONTHLY_BUDGET_USD": "5"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "cookpool-prod-apac",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "cookpool-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "cookpool-policy-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "cookpool-notifications-worker-prod"
        },
        {
          "binding": "IDENTITY_WORKER",
          "service": "cookpool-identity-worker-prod"
        }
      ]
    }
  }
}
