{
  "name": "@saas/mcp-worker-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250508.0",
    "@saas/eslint-config": "workspace:*",
    "@saas/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@saas/contracts": "workspace:*",
    "@saas/kitchen-engine": "workspace:*"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^cloudflare:workers$": "<rootDir>/src/stubs/cloudflare-workers.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@saas/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^@saas/contracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1.ts",
      "^@saas/kitchen-engine$": "<rootDir>/../../packages/kitchen-engine/src/index.ts",
      "^@saas/kitchen-engine/(.*)$": "<rootDir>/../../packages/kitchen-engine/src/$1.ts",
      "^@mcp-worker/(.*)$": "<rootDir>/../../apps/mcp-worker/src/$1.ts"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/src/setup.ts"
    ]
  }
}
