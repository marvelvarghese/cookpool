{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "paths": {
      "@saas/contracts": ["../../packages/contracts/src/index.ts"],
      "@saas/contracts/*": ["../../packages/contracts/src/*.ts"],
      "@saas/spliteco-ui": ["../../packages/spliteco-ui/src/index.ts"],
      "@saas/spliteco-ui/*": ["../../packages/spliteco-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
