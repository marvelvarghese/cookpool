{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["../../apps/web-console-next/src/*"],
      "@web-console-next/*": ["../../apps/web-console-next/src/*"],
      "@saas/contracts": ["../../packages/contracts/src/index.ts"],
      "@saas/contracts/*": ["../../packages/contracts/src/*.ts"],
      "@saas/kitchen-engine": ["../../packages/kitchen-engine/src/index.ts"],
      "@saas/kitchen-engine/*": ["../../packages/kitchen-engine/src/*.ts"],
      "@saas/spliteco-ui": ["../../packages/spliteco-ui/src/index.ts"],
      "@saas/spliteco-ui/*": ["../../packages/spliteco-ui/src/*"],
      "@tanstack/react-query": ["../../apps/web-console-next/node_modules/@tanstack/react-query"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../apps/web-console-next/src/components/ui/button.tsx",
    "../../apps/web-console-next/src/components/webhooks/rotate-flow.ts",
    "../../apps/web-console-next/src/components/webhooks/endpoint-crud.ts",
    "../../apps/web-console-next/src/components/webhooks/delivery-history.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
