{
  "name": "@saas/spliteco-worker-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250508.0",
    "@saas/eslint-config": "workspace:*",
    "@saas/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@saas/contracts": "workspace:*",
    "@saas/db": "workspace:*",
    "@saas/kitchen-engine": "workspace:*",
    "@saas/policy-engine": "workspace:*",
    "@saas/notifications-client": "workspace:*"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@saas/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^@saas/contracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1.ts",
      "^@saas/policy-engine$": "<rootDir>/../../packages/policy-engine/src/index.ts",
      "^@saas/kitchen-engine$": "<rootDir>/../../packages/kitchen-engine/src/index.ts",
      "^@saas/kitchen-engine/(.*)$": "<rootDir>/../../packages/kitchen-engine/src/$1.ts",
      "^@saas/db$": "<rootDir>/../../packages/db/src/index.ts",
      "^@saas/db/manifest$": "<rootDir>/../../packages/db/src/manifest.ts",
      "^@saas/db/types$": "<rootDir>/../../packages/db/src/types.ts",
      "^@saas/db/(.*)$": "<rootDir>/../../packages/db/src/$1/index.ts",
      "^@spliteco-worker/(.*)$": "<rootDir>/../../apps/spliteco-worker/src/$1.ts",
      "^@membership-worker/(.*)$": "<rootDir>/../../apps/membership-worker/src/$1.ts",
      "^@saas/notifications-client$": "<rootDir>/../../packages/notifications-client/src/index.ts",
      "^@kitchen-worker/(.*)$": "<rootDir>/../../apps/kitchen-worker/src/$1.ts",
      "^@api-edge/(.*)$": "<rootDir>/../../apps/api-edge/src/$1.ts",
      "^@mcp-worker/(.*)$": "<rootDir>/../../apps/mcp-worker/src/$1.ts",
      "^zod$": "<rootDir>/../../apps/mcp-worker/node_modules/zod"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ]
  }
}
