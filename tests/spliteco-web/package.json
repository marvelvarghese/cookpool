{
  "name": "@saas/spliteco-web-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@saas/contracts": "workspace:*",
    "@saas/eslint-config": "workspace:*",
    "@saas/kitchen-engine": "workspace:*",
    "@saas/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@saas/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^@saas/contracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1.ts",
      "^@saas/kitchen-engine$": "<rootDir>/../../packages/kitchen-engine/src/index.ts",
      "^@saas/spliteco-ui$": "<rootDir>/../../packages/spliteco-ui/src/index.ts",
      "^@saas/spliteco-ui/(.*)$": "<rootDir>/../../packages/spliteco-ui/src/$1",
      "^@saas/kitchen-engine/(.*)$": "<rootDir>/../../packages/kitchen-engine/src/$1.ts",
      "^@spliteco-web/(.*)$": "<rootDir>/../../apps/spliteco-web/src/$1",
      "^@/(.*)$": "<rootDir>/../../apps/spliteco-web/src/$1"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "useESM": true }]
    },
    "testMatch": ["<rootDir>/src/**/*.test.ts"]
  }
}
